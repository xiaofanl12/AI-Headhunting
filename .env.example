# ============================================================
#  环境变量模板
#  使用方法：复制本文件为 .env，再按下述注释逐项填写
#      cp .env.example .env      (Windows: copy .env.example .env)
#  .env 已被 .gitignore 排除，真实密钥不会进入版本库。
#  留空的项会退回默认值或自动降级，不影响系统启动。
# ============================================================


# ===== 大模型：OpenAI 兼容协议（火山方舟 / 智谱 / 任意网关）=====
# 模型服务的接口地址。换服务商时只改这一行，路径须以 /v3 之类的版本号结尾
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 【需填写】模型 API Key。在模型服务商控制台的「API Key 管理」处创建并复制
#   火山方舟：https://console.volcengine.com/ark  →  API Key 管理
#   智谱：https://open.bigmodel.cn/usercenter/apikeys
#   留空则系统自动降级为规则模板模式：推荐理由与邮件由模板生成
LLM_API_KEY=your_llm_api_key_here

# 主模型名称，须与服务商控制台中已开通的模型 ID 完全一致，例如 glm-5.3-flash
LLM_MODEL=glm-5.3-flash

# 备用模型名称。主模型调用失败时自动切换，留空则不启用
LLM_MODEL_FALLBACK=


# ===== MySQL 数据库 =====
# 数据库主机地址。本机部署填 127.0.0.1，远程填对应 IP 或域名
DB_HOST=127.0.0.1

# MySQL 端口，默认 3306
DB_PORT=3306

# 数据库登录用户名
DB_USER=root

# 【需填写】数据库登录密码。即安装 MySQL 时为 root 设置的密码
DB_PASSWORD=your_mysql_password

# 数据库名称。执行 db/schema.sql 时会自动创建，默认为 headhunter
DB_NAME=headhunter


# ===== SMTP 邮件（发送面试邀约）=====
# 发件邮箱的 SMTP 服务器地址。QQ 邮箱为 smtp.qq.com，163 邮箱为 smtp.163.com
SMTP_HOST=smtp.qq.com

# SMTP 端口。465 为 SSL 加密端口，与下方 SMTP_FROM_NAME 配合使用
SMTP_PORT=465

# 【需填写】发件邮箱地址，即系统用哪个邮箱发信，须与下方授权码同属一个账号
SMTP_USER=your_account@example.com

# 【需填写】邮箱授权码（16 位字符串），不是邮箱登录密码
#   QQ 邮箱：网页版「设置 → 账号 → 开启 SMTP 服务」后生成授权码
#   163 邮箱：网页版「设置 → POP3/SMTP/IMAP → 新增授权密码」
#   示例：abcdefghijklmnop（仅示意格式，切勿照抄）
SMTP_PASSWORD=your_smtp_auth_code

# 发件人显示名称，收件人邮件列表中看到的名称
SMTP_FROM_NAME=AI猎头助手


# ===== 安全限制 =====
# 每日最多发送的邀约邮件封数，防止误操作把发件箱发爆，默认 100
DAILY_SEND_LIMIT=100


# ===== 企查查开放平台（公司背调第二数据源，可选）=====
# 到 https://open.qichacha.cn 注册并申请接口，在控制台「我的接口」查看 Key 与 SecretKey
# 【需填写】两个值须成对填写才会启用；留空则自动跳过企查查通道，公司背调改用百科与模型
QCC_API_KEY=your_qcc_api_key
QCC_API_SECRET=your_qcc_api_secret


# ===== 演示账号（可选）=====
# 【需填写】覆盖默认演示密码，仅用于对外演示环境
# 留空则使用 web/auth.py 中的默认值；部署到公网前务必设置此变量
DEMO_PASSWORD=
