# ===== 大模型：OpenAI 兼容协议（火山方舟 / 智谱 / 任意网关）=====
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 在这里填入你自己的 API Key（填了占位文字等于没配，系统会自动降级为规则模式）
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=glm-5.3-flash
# 备用模型：主模型不可用时自动降级，留空则不启用
LLM_MODEL_FALLBACK=

# ===== MySQL =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=headhunter

# ===== SMTP（发面试邀约邮件用）=====
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_account@qq.com
# 注意：这里填的是「授权码」，不是邮箱登录密码
SMTP_PASSWORD=your_smtp_auth_code
SMTP_FROM_NAME=AI猎头助手

# ===== 安全限制 =====
# 每日最多发送多少封邀约邮件，防止误操作把邮箱发爆
DAILY_SEND_LIMIT=100

# ===== 企查查开放平台（公司背调第二数据源，可选）=====
# 到 https://open.qichacha.cn 注册申请（有免费试用额度），未配置则自动跳过该数据源
QCC_API_KEY=
QCC_API_SECRET=
