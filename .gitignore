# ===== 敏感配置：真实密钥与密码，一律不入库 =====
.env
.env.*
!.env.example
*.env
# 各类密钥、证书与本地凭据文件
*.pem
*.key
*.p12
*.pfx
secrets.*
credentials.*
config.local.*

# ===== Python =====
__pycache__/
*.py[cod]
.pytest_cache/
venv/
.venv/

# ===== 数据与个人信息（导出/备份含真实联系方式，一律不入库）=====
data/
!data/candidates.sample.csv
!data/positions.sample.csv

# ===== 数据库转储（可能含候选人资料与账号哈希）=====
*.dump
*.sql.gz
backup/

# ===== 界面截图与录屏（体积大，且可能露出候选人姓名）=====
tools/shots/
*.mp4
*.mov
*.avi

# ===== IDE 与本机配置 =====
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# ===== 日志与临时文件 =====
*.log
*.tmp

# 本地密钥备份（勿入库）
.env.bak.*

# ===== 文档目录（README 引用的演示视频放行）=====
# 其余 mp4 默认忽略，仅 docs/demo.mp4 入库
*.mp4
!docs/demo.mp4
